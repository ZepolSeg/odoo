<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_planning_inherit_odoo18" model="ir.ui.view">
        <field name="name">hr.employee.form.planning.inherit.odoo18</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
             <!-- Find a reliable place to add the field. The 'hr_settings' page is common. -->
             <xpath expr="//page[@name='hr_settings']" position="inside">
                 <group string="Planning Roles" name="planning_group">
                    <field name="planning_role_ids" widget="many2many_tags"
                           options="{'color_field': 'color', 'no_create': True, 'no_edit': True}"
                           placeholder="Select roles this employee can perform..."/>
                 </group>
             </xpath>
        </field>
    </record>
</odoo>