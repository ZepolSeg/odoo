<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record id="view_planning_slot_form" model="ir.ui.view">
            <field name="name">planning.slot.form</field>
            <field name="model">planning.slot</field>
            <field name="arch" type="xml">
                <form string="Planning Slot">
                    <header>
                        <button name="action_publish" string="Publish" type="object" class="oe_highlight" invisible="state != 'draft'" data-hotkey="k"/>
                        <button name="action_generate_recurrence" string="Generate Recurrence" type="object" class="oe_highlight" icon="fa-refresh" invisible="(not rrule) or (state != 'draft') or (recurrence_id != False)" help="Generates future recurring shifts based on the RRULE."/>
                        <button name="action_cancel" string="Cancel" type="object" icon="fa-times-circle" invisible="state != 'published'"/>
                        <button name="action_set_draft" string="Set to Draft" type="object" icon="fa-pencil-square-o" invisible="state == 'draft'" data-hotkey="d"/>
                        <button name="action_delete_recurrence" string="Delete Future Recurrence" type="object" icon="fa-trash" confirm="Are you sure you want to delete ALL future draft/published occurrences linked to this template? This action cannot be undone." invisible="not rrule or recurrence_id" help="Deletes future draft &amp; published shifts generated from this template." groups="hr.group_hr_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <widget name="web_ribbon" title="Cancelled" bg_color="bg-warning" invisible="state != 'cancelled'"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <label for="role_id" class="oe_edit_only" string="Role / Task"/>
                            <h1>
                                <field name="role_id"
                                       placeholder="Select Role..."
                                       options="{'no_open': True, 'no_create': True}"
                                       context="{'active_test': True}"/>
                            </h1>
                            <label for="employee_id" class="oe_edit_only" string="Assigned To"/>
                            <field name="employee_id"
                                   placeholder="Assign Employee..."
                                   options="{'no_open': True, 'no_create': True}"
                                   domain="[('planning_role_ids', 'in', role_id)]"
                                   context="{'active_test': True}"/>
                        </div>
                        <group>
                            <group>
                                <label for="start_datetime" string="Period"/>
                                <div class="o_row">
                                    <field name="start_datetime" nolabel="1" required="1"/>
                                    <span> - </span>
                                    <field name="end_datetime" nolabel="1" required="1"/>
                                </div>
                                <field name="duration" widget="float_time"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes" name="notes_page">
                                <field name="notes" placeholder="Add internal notes or instructions..."/>
                            </page>
                            <page string="Recurrence" name="recurrence_page">
                                <group>
                                    <field name="recurrence_id" readonly="1" options="{'no_open': True}" invisible="not recurrence_id" string="Part of Recurrence"/>
                                    <field name="rrule" placeholder="e.g. FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR;UNTIL=20241231T000000Z" readonly="recurrence_id"/>
                                </group>
                                <div invisible="not rrule and not recurrence_id">
                                    <p class="oe_grey" invisible="recurrence_id"> Use RRULE format to define the repetition pattern. Click <i class="fa fa-refresh"/> <strong>Generate Recurrence</strong> in the header to create the corresponding shifts (as drafts). Editing this template later might require regenerating occurrences. Future occurrences can be deleted using the <i class="fa fa-trash"/> <strong>Delete Future Recurrence</strong> button. </p>
                                    <p class="oe_grey" invisible="not recurrence_id"> This shift is an occurrence generated from the template linked above. Changes here will not affect the template or other occurrences. </p>
                                    <p><a href="https://icalendar.org/iCalendar-RFC-5545/3-8-5-3-recurrence-rule.html" target="_blank" class="oe_link">RRULE Format Documentation <i class="fa fa-external-link"/></a></p>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Action pour Popup Form -->
        <record id="action_planning_slot_form_popup" model="ir.actions.act_window">
            <field name="name">Create Planning Shift</field>
            <field name="res_model">planning.slot</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_planning_slot_form"/>
        </record>

        <!-- List View (Version Simplifiée pour Test) -->
        <record id="view_planning_slot_list" model="ir.ui.view">
            <field name="name">planning.slot.list.test</field>
            <field name="model">planning.slot</field>
            <field name="arch" type="xml">
                <list string="Planning Shifts">
                    <field name="start_datetime"/>
                    <field name="end_datetime"/>
                    <field name="employee_id"/>
                    <field name="role_id"/>
                    <field name="state"/>
                    <field name="active" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_planning_slot_search" model="ir.ui.view">
            <field name="name">planning.slot.search</field>
            <field name="model">planning.slot</field>
            <field name="arch" type="xml">
                <search string="Search Planning Slots">
                    <field name="employee_id"/>
                    <field name="role_id"/>
                    <field name="notes" string="Notes contain..."/>
                    <separator/>
                    <filter string="My Shifts" name="my_shifts" domain="[('employee_id.user_id', '=', uid)]"/>
                    <filter string="Unassigned" name="unassigned" domain="[('employee_id', '=', False)]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <filter string="Recurrence Templates" name="templates" domain="[('rrule', '!=', False), ('recurrence_id', '=', False)]"/>
                    <filter string="Recurrence Occurrences" name="occurrences" domain="[('recurrence_id', '!=', False)]"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <field name="start_datetime" string="Shift Period"/>
                    <filter string="Date" name="filter_period" date="start_datetime"/>
                    <group expand="1" string="Group By">
                        <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Role" name="group_by_role" context="{'group_by': 'role_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <separator/>
                        <filter string="Start Date (Day)" name="group_by_start_day" context="{'group_by': 'start_datetime:day'}"/>
                        <filter string="Start Date (Week)" name="group_by_start_week" context="{'group_by': 'start_datetime:week'}"/>
                        <filter string="Start Date (Month)" name="group_by_start_month" context="{'group_by': 'start_datetime:month'}"/>
                        <separator/>
                        <filter string="Recurrence Template" name="group_by_recurrence" domain="[('recurrence_id', '!=', False)]" context="{'group_by':'recurrence_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_planning_slot_pivot" model="ir.ui.view">
            <field name="name">planning.slot.pivot</field>
            <field name="model">planning.slot</field>
            <field name="arch" type="xml">
                <pivot string="Planning Analysis" display_quantity="true"><field name="employee_id" type="row"/><field name="role_id" type="row"/><field name="start_datetime" interval="week" type="col"/><field name="duration" type="measure"/><field name="state" type="row"/></pivot>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_planning_slot_graph" model="ir.ui.view">
            <field name="name">planning.slot.graph</field>
            <field name="model">planning.slot</field>
            <field name="arch" type="xml">
                 <graph string="Planning Analysis"><field name="role_id" type="row"/><field name="start_datetime" interval="month" type="col"/><field name="duration" type="measure"/></graph>
             </field>
         </record>

<!-- Calendar View (Simplifié pour Test Odoo 18) -->
        <record id="view_planning_slot_calendar" model="ir.ui.view">
            <field name="name">planning.slot.calendar.test</field> <!-- Nom unique pour test si besoin -->
            <field name="model">planning.slot</field>
            <field name="arch" type="xml">
                <!-- Balise <calendar> simple avec juste date_start et un champ -->
                <calendar string="Planning Calendar"
                          date_start="start_datetime">
                    <field name="display_name"/>
                </calendar>
            </field>
        </record>

        <!-- Main Action (Sans Gantt) -->
        <record id="action_planning_slot" model="ir.actions.act_window">
            <field name="name">Planning Shifts</field>
            <field name="res_model">planning.slot</field>
            <field name="view_mode">list,form,calendar,pivot,graph</field> <!-- Gantt retiré -->
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_planning_slot_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_planning_slot_form')}),
                (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_planning_slot_calendar')}),
                (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_planning_slot_pivot')}),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('view_planning_slot_graph')}),
            ]"/> <!-- Ligne Gantt retirée -->
            <field name="search_view_id" ref="view_planning_slot_search"/>
            <field name="context">{
                'search_default_group_by_employee': 1,
                'search_default_filter_period': 1,
                'search_default_published': 1,
                }
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face"> Schedule a new planning shift. </p>
                <p> Assign employees to roles for specific time periods. <br/> Remember to publish shifts to make them official. Use recurrence features for regular shifts. Check coverage using the menu action. </p>
            </field>
        </record>

    </data>
</odoo>