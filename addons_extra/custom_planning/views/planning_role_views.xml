<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_planning_role_list" model="ir.ui.view">
             <!-- ... contenu de la vue liste ... -->
             <field name="name">planning.role.list</field>
            <field name="model">planning.role</field>
            <field name="arch" type="xml">
                <list string="Planning Roles" editable="top"><field name="sequence" widget="handle"/><field name="name"/><field name="color" widget="color_picker"/><field name="min_required_daily" optional="show"/><field name="max_allowed_daily" optional="show"/><field name="active" widget="boolean_toggle"/></list>
             </field>
        </record>

        <!-- Form View (Corrected web_ribbon) -->
        <record id="view_planning_role_form" model="ir.ui.view">
            <field name="name">planning.role.form</field>
            <field name="model">planning.role</field>
            <field name="arch" type="xml">
                <form string="Planning Role">
                    <sheet>
                        <!-- Remplacement de attrs par invisible directement -->
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <!-- La logique est la même : invisible si active est True -->
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="e.g. Cashier, Backend Developer" required="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="color" widget="color_picker"/>
                                <field name="sequence"/>
                            </group>
                            <group string="Coverage Requirements (Per Day)">
                                <field name="min_required_daily"/>
                                <field name="max_allowed_daily"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Assigned Employees" name="employees_page">
                                <field name="employee_ids" widget="many2many" context="{'active_test': False}">
                                    <!-- ... kanban definition ... -->
                                    <kanban quick_create="false">
                                        <field name="id"/>
                                        <field name="name"/>
                                        <field name="avatar_128"/>
                                        <templates><t t-name="kanban-box"><div t-attf-class="oe_kanban_global_click"><div class="o_kanban_image"><img alt="Avatar" t-att-src="kanban_image('hr.employee', 'avatar_128', record.id.raw_value)"/></div><div class="oe_kanban_details"><strong class="o_kanban_record_title"><field name="name"/></strong></div></div></t></templates>
                                    </kanban>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_planning_role_search" model="ir.ui.view">
            <!-- ... contenu de la vue recherche ... -->
             <field name="name">planning.role.search</field>
            <field name="model">planning.role</field>
            <field name="arch" type="xml">
                <search string="Search Planning Roles"><field name="name"/><filter string="Archived" name="inactive" domain="[('active', '=', False)]"/><separator/><filter string="Has Coverage Limits" name="coverage_limits" domain="['|', ('min_required_daily', '>', 0), ('max_allowed_daily', '>', 0)]"/></search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_planning_role" model="ir.actions.act_window">
            <!-- ... contenu de l'action ... -->
             <field name="name">Planning Roles</field>
            <field name="res_model">planning.role</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_planning_role_search"/>
            <field name="help" type="html"><p class="o_view_nocontent_smiling_face"> Define a new Planning Role. </p><p> Create roles like "Cashier", "Developer", "Manager" to assign to employees and shifts. You can define daily min/max coverage requirements per role. </p></field>
        </record>

    </data>
</odoo>