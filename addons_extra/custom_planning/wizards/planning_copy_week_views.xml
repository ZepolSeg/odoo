<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data> <!-- Ensure <data> tag -->
        <!-- Form View (Inchangé) -->
        <record id="view_planning_copy_wizard_form" model="ir.ui.view">
            <field name="name">planning.copy.wizard.form</field>
            <field name="model">planning.copy.wizard</field>
            <field name="arch" type="xml">
                <!-- Contenu du Formulaire Wizard inchangé -->
                 <form string="Copy Planning Week">
                    <p> Copy shifts from a source week to a target week. You can filter which shifts are copied and decide the state of the new shifts. </p>
                    <group><group string="Source Week &amp; Filters"><field name="source_date_start"/><field name="state_filter"/><field name="employee_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}" placeholder="All Employees"/><field name="role_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}" placeholder="All Roles"/></group> <group string="Target Week &amp; Options"><field name="target_date_start"/><field name="target_state"/><field name="copy_assignments"/></group></group>
                     <footer><button name="action_copy_week" string="Copy Shifts" type="object" class="btn-primary" data-hotkey="q"/><button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/></footer>
                </form>
            </field>
        </record>

        <!-- Action to open the wizard (Changer list dans binding_view_types si besoin) -->
        <record id="action_planning_copy_week" model="ir.actions.act_window">
            <field name="name">Copy Week</field>
            <field name="res_model">planning.copy.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_planning_slot"/>
            <!-- Remplacer list par list s'il y avait tree -->
            <field name="binding_view_types">gantt,list,calendar</field>
        </record>
    </data> <!-- Ensure closing tag -->
</odoo>